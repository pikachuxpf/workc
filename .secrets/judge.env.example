# Copy this template to ~/.agents/skills/workc/.secrets/judge.env
# Replace placeholders only in the local judge.env. Never commit that file.

JUDGE_BASE_URL=https://example.invalid/v1
JUDGE_API_KEY=replace-with-your-api-key
JUDGE_MODEL_ID=replace-with-model-id

# Non-secret runtime settings
JUDGE_TIMEOUT_SEC=100
JUDGE_MAX_TOKENS=4096
JUDGE_CACHE_DIR=/tmp/judge_cache
JUDGE_DISABLE_CACHE=0
JUDGE_MAX_ATTEMPTS=5
JUDGE_RETRY_BASE_DELAY=2.0
